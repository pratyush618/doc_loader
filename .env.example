# Application Settings
APP_NAME=doc-converter
APP_ENV=production
DEBUG=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Settings
UPLOAD_DIR=/tmp/doc_converter/uploads
OUTPUT_DIR=/tmp/doc_converter/outputs
MAX_FILE_SIZE=104857600  # 100MB

# Webhook Settings
DEFAULT_WEBHOOK_URL=
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3

# Security Settings
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=*

# Image Processing
IMAGE_COMPRESSION_QUALITY=95
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048

# OCR Settings
# Mistral AI API key for OCR (required for Mistral OCR provider)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=pixtral-12b-2409

# PaddleOCR Settings
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_LANG=en
PADDLE_MODELS_DIR=./models/paddle_models

# PaddlePaddle Environment (suppress warnings)
FLAGS_use_mkldnn=0
FLAGS_enable_eager_mode=1
PADDLE_LOG_LEVEL=3
